# Copia este archivo como .env y completa los valores. El .env no se sube a GitHub.

# URI de MongoDB Atlas (Connect > Drivers). Agrega el nombre de la base antes del "?".
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/lumina?retryWrites=true&w=majority

# Clave para firmar los JWT: al menos 32 caracteres al azar.
# En PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=
